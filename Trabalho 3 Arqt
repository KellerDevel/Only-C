<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anime World</title>

    <style>

        body{
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #ececec;
        }

        header{
            background-color: #5b21b6;
            color: white;
            text-align: center;
            padding: 20px;
            border-bottom: 4px solid black;
        }

        header h1{
            margin: 0;
        }

        .conteudo{
            width: 80%;
            margin: auto;
            margin-top: 20px;
        }

        .anime-img{
            width: 300px;
            border: 4px solid #5b21b6;
            border-radius: 10px;
            transition: 0.3s;
        }

        .anime-img:hover{
            transform: scale(1.05);
            border-color: red;
        }

        a{
            display: inline-block;
            margin-top: 10px;
            background-color: #5b21b6;
            color: white;
            padding: 10px;
            text-decoration: none;
            border-radius: 5px;
            border: 2px solid black;
        }

        a:hover{
            background-color: black;
            color: yellow;
        }

        table{
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
            background-color: white;
        }

        th{
            background-color: #5b21b6;
            color: white;
            padding: 10px;
            border: 2px solid black;
        }

        td{
            padding: 10px;
            border: 2px solid black;
        }

        tr:hover{
            background-color: #ddd;
        }

        ul{
            background-color: white;
            padding: 20px;
            border-radius: 10px;
            border: 2px solid #5b21b6;
        }

        li{
            margin-bottom: 10px;
        }

        form{
            background-color: white;
            padding: 20px;
            margin-top: 20px;
            border-radius: 10px;
            border: 2px solid #5b21b6;
        }

        input{
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            margin-bottom: 15px;
            border: 2px solid gray;
            border-radius: 5px;
        }

        input:focus{
            border-color: #5b21b6;
            outline: none;
        }

        button{
            background-color: #5b21b6;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 5px;
            cursor: pointer;
        }

        button:hover{
            background-color: black;
        }

    </style>

</head>
<body>

    <header>
        <h1>Anime Showcase</h1>
        <p>Site de anime para betinhas</p>
    </header>

    <div class="conteudo">

        <h2>Anime em destaque</h2>

        <img class="anime-img" src="https://imgs.search.brave.com/0KDF5hq75-dCGnKSE1IL5ZbziU5oDWeRYKdmQ4GWj0k/rs:fit:500:0:1:0/g:ce/aHR0cHM6Ly9pLnJl/ZGQuaXQvcnhmYm43/M25zNHJkMS5wbmc" alt="Goku">

        <br>

        <a href="https://www.crunchyroll.com/pt-br" target="_blank">
            Visitar site de animes
        </a>

        <h2>Top personagens</h2>

        <ul>
            <li>Goku</li>
            <li>Naruto</li>
            <li>Luffy</li>
            <li>Levi Ackerman</li>
        </ul>

        <h2>Tabela de Animes</h2>

        <table>

            <tr>
                <th>Anime</th>
                <th>Gênero</th>
                <th>Nota</th>
            </tr>

            <tr>
                <td>Dragon Ball</td>
                <td>Ação</td>
                <td>10</td>
            </tr>

            <tr>
                <td>Naruto</td>
                <td>Aventura</td>
                <td>9</td>
            </tr>

            <tr>
                <td>One Piece</td>
                <td>Shounen</td>
                <td>10</td>
            </tr>

        </table>

        <h2>Formulário</h2>

        <form>

            <label>Nome:</label>
            <input type="text" placeholder="Digite seu nome">

            <label>Anime favorito:</label>
            <input type="text" placeholder="Digite o anime">

            <button type="submit">Enviar</button>

        </form>

    </div>

</body>
</html>
